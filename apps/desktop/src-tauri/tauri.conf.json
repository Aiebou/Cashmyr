{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Cashmyr",
  "version": "../package.json",
  "identifier": "io.github.aiebou.cashmyr",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cashmyr",
        "width": 1240,
        "height": 840,
        "minWidth": 380,
        "minHeight": 560,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost ws://localhost:1420",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Finance",
    "shortDescription": "Budget personnel hors ligne",
    "longDescription": "Cashmyr tient ton budget sur tes appareils, sans compte ni serveur. La synchronisation passe par un fichier que tu choisis dans ton propre dossier cloud.",
    "publisher": "Aiebou",
    "copyright": "© 2026 Aiebou",
    "license": "MIT",
    "homepage": "https://github.com/Aiebou/Cashmyr",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQyQjUxNDg4MTdCMTNGNDQKUldSRVA3RVhpQlMxUWpsQWp0TmIrV1N5Mms4OFF2NjhTVmloWUJUS0Z3dE90UFd5Yk52T3J5eVcK",
      "endpoints": ["https://github.com/Aiebou/Cashmyr/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
