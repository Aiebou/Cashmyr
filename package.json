{
  "name": "cashmyr",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "pnpm --filter @cashmyr/web dev",
    "dev:desktop": "pnpm --filter @cashmyr/desktop tauri dev",
    "build:web": "pnpm --filter @cashmyr/web build",
    "build:desktop": "pnpm --filter @cashmyr/desktop tauri build",
    "test": "pnpm -r --if-present test",
    "test:rust": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "typecheck": "pnpm -r --if-present typecheck"
  }
}
